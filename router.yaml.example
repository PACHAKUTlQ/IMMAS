router:
  log_path: router_run.jsonl
  log_append: false
  routing: auction
  warmup:
    enabled: true
    requests_per_backend: 3
    max_concurrency: 4
    timeout_s: 30.0
    max_tokens: 1000
  batching:
    enabled: true
    max_batch_size: 16
    max_wait_ms: 10.0
    max_queue_size: 4096
  auction:
    delta_default: 0.5
    min_welfare_edge: 0.0
    mcmf_scale: 1000
    quality_scale: 100.0
    latency_scale: 5.0
    cost_scale: 0.02
  performance:
    enabled: true
    coqa_split: validation
    # evaluator: token_span
    evaluator: rouge
    rouge_metric: rouge-l
    rouge_f1_threshold: 0.3
    lowercase: true
  detailed_csv:
    enabled: false
    path: router_detailed_answers.csv
    append: false
    flush_every: 1


backends:
  - id: b0
    base_url_v1: http://127.0.0.1:8000/v1
    api_key: sk-local
    model: llama3

  - id: b1
    base_url_v1: http://127.0.0.1:8001/v1
    api_key: sk-local
    model: qwen3
