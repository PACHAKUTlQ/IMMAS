router:
  log_path: router_run.jsonl
  log_append: false
  routing: round_robin
  batching:
    enabled: true
    max_batch_size: 16
    max_wait_ms: 10.0
    max_queue_size: 4096

backends:
  - id: b0
    base_url_v1: http://127.0.0.1:8000/v1
    api_key: sk-local
    model: llama3

  - id: b1
    base_url_v1: http://127.0.0.1:8001/v1
    api_key: sk-local
    model: qwen3
