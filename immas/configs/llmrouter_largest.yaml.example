router:
  log_path: router_run.jsonl
  log_append: false
  routing: llmrouter
  warmup:
    enabled: true
    max_dialogues: 1
    max_turns_per_dialogue: 2
    max_concurrency: 4
    timeout_s: 30.0
    max_tokens: 64
  batching:
    enabled: true
    max_batch_size: 16
    max_wait_ms: 10.0
    max_queue_size: 4096
  auction:
    delta_default: 0.5
    min_welfare_edge: 0.0
    mcmf_scale: 1000
    quality_scale: 100.0
    latency_scale: 5.0
    cost_scale: 0.02
  llmrouter:
    name: "largest_llm"
    config_path: "baseline/one_click/router_configs/largest_llm_online.yaml"
    load_model_path: ""
    model_name_to_backend_id:
      Mistral-7B: b0
      Qwen2.5-7b: b0

backends:
  - id: b0
    base_url_v1: http://127.0.0.1:8000/v1
    api_key: sk-local
    model: placeholder-model
    capacity: 4
